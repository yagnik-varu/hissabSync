generator client {
  provider = "prisma-client"
  output   = "../generated/prisma/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum RoomStatus {
  ACTIVE
  ARCHIVED
}

enum Role {
  ADMIN
  ACCOUNTANT
  MEMBER
}

enum MemberStatus {
  ACTIVE
  PENDING_APPROVAL
  LEAVE_REQUESTED
  LEFT
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum ReferenceType {
  CONTRIBUTION
  REIMBURSEMENT
  ADJUSTMENT
}

enum ContributionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ReimbursementStatus {
  PENDING_PAYMENT
  PAID
  REJECTED
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName        String   @map("full_name") @db.VarChar(100)
  email           String   @unique @db.VarChar(255)
  phone           String?  @db.VarChar(20)
  passwordHash    String   @map("password_hash") @db.Text
  profileImageUrl String?  @map("profile_image_url") @db.Text
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  refreshTokens         RefreshToken[]
  roomMemberships       RoomMember[]
  joinRequests          JoinRequest[]         @relation("UserJoinRequests")
  reviewedJoinRequests  JoinRequest[]         @relation("AdminReviewedJoinRequests")
  createdRooms          Room[]                @relation("UserCreatedRooms")
  treasuryTransactions  TreasuryTransaction[]
  contributions         Contribution[]        @relation("UserContributions")
  approvedContributions Contribution[]        @relation("AdminApprovedContributions")
  expenses              Expense[]             @relation("UserExpenses")
  reviewedExpenses      Expense[]             @relation("AdminReviewedExpenses")
  reimbursements        Reimbursement[]       @relation("UserReimbursements")
  paidReimbursements    Reimbursement[]       @relation("AdminPaidReimbursements")
  notifications         Notification[]
  auditLogs             AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.Text
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Room {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String     @db.VarChar(100)
  roomCode    String     @unique @map("room_code") @db.VarChar(20)
  description String?    @db.Text
  status      RoomStatus @default(ACTIVE)
  createdBy   String     @map("created_by") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  creator User @relation("UserCreatedRooms", fields: [createdBy], references: [id], onDelete: Restrict)

  settings             RoomSettings?
  treasuryAccount      TreasuryAccount?
  members              RoomMember[]
  joinRequests         JoinRequest[]
  expenseCategories    ExpenseCategory[]
  contributions        Contribution[]
  expenses             Expense[]
  reimbursements       Reimbursement[]
  treasuryTransactions TreasuryTransaction[]
  notifications        Notification[]
  auditLogs            AuditLog[]

  @@map("rooms")
}

model RoomSettings {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId                      String   @unique @map("room_id") @db.Uuid
  currencyCode                String   @default("INR") @map("currency_code") @db.VarChar(10)
  allowNegativeTreasury       Boolean  @default(false) @map("allow_negative_treasury")
  requireExpenseApproval      Boolean  @default(true) @map("require_expense_approval")
  requireContributionApproval Boolean  @default(true) @map("require_contribution_approval")
  autoCreateReimbursement     Boolean  @default(true) @map("auto_create_reimbursement")
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("room_settings")
}

model RoomMember {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId    String       @map("room_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  role      Role         @default(MEMBER)
  status    MemberStatus @default(ACTIVE)
  joinedAt  DateTime     @default(now()) @map("joined_at") @db.Timestamptz
  leftAt    DateTime?    @map("left_at") @db.Timestamptz
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
  @@index([roomId, role])
  @@map("room_members")
}

model JoinRequest {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId          String            @map("room_id") @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  status          JoinRequestStatus @default(PENDING)
  rejectionReason String?           @map("rejection_reason") @db.Text
  reviewedBy      String?           @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?         @map("reviewed_at") @db.Timestamptz
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz

  room     Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User  @relation("UserJoinRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("AdminReviewedJoinRequests", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@map("join_requests")
}

model TreasuryAccount {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId         String   @unique @map("room_id") @db.Uuid
  currentBalance Decimal  @default(0.00) @map("current_balance") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("treasury_accounts")
}

model TreasuryTransaction {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId          String          @map("room_id") @db.Uuid
  transactionType TransactionType @map("transaction_type")
  referenceType   ReferenceType   @map("reference_type")
  referenceId     String?         @map("reference_id") @db.Uuid
  amount          Decimal         @db.Decimal(12, 2)
  description     String          @db.Text
  createdBy       String          @map("created_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz

  room  Room @relation(fields: [roomId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([roomId, createdAt(sort: Desc)])
  @@map("treasury_transactions")
}

model Contribution {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId          String             @map("room_id") @db.Uuid
  contributorId   String             @map("contributor_id") @db.Uuid
  amount          Decimal            @db.Decimal(12, 2)
  note            String?            @db.Text
  status          ContributionStatus @default(PENDING)
  rejectionReason String?            @map("rejection_reason") @db.Text
  approvedBy      String?            @map("approved_by") @db.Uuid
  approvedAt      DateTime?          @map("approved_at") @db.Timestamptz
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  room        Room  @relation(fields: [roomId], references: [id], onDelete: Restrict)
  contributor User  @relation("UserContributions", fields: [contributorId], references: [id], onDelete: Restrict)
  approver    User? @relation("AdminApprovedContributions", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([roomId, status])
  @@map("contributions")
}

model ExpenseCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  name      String   @db.VarChar(100)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  room     Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([roomId, name])
  @@map("expense_categories")
}

model Expense {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId          String        @map("room_id") @db.Uuid
  submittedBy     String        @map("submitted_by") @db.Uuid
  categoryId      String        @map("category_id") @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  title           String        @db.VarChar(255)
  description     String?       @db.Text
  receiptUrl      String?       @map("receipt_url") @db.Text
  status          ExpenseStatus @default(PENDING)
  rejectionReason String?       @map("rejection_reason") @db.Text
  reviewedBy      String?       @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?     @map("reviewed_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  room          Room            @relation(fields: [roomId], references: [id], onDelete: Restrict)
  submitter     User            @relation("UserExpenses", fields: [submittedBy], references: [id], onDelete: Restrict)
  category      ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reviewer      User?           @relation("AdminReviewedExpenses", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reimbursement Reimbursement?

  @@index([roomId, status])
  @@index([submittedBy])
  @@map("expenses")
}

model Reimbursement {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expenseId     String              @unique @map("expense_id") @db.Uuid
  roomId        String              @map("room_id") @db.Uuid
  beneficiaryId String              @map("beneficiary_id") @db.Uuid
  amount        Decimal             @db.Decimal(12, 2)
  status        ReimbursementStatus @default(PENDING_PAYMENT)
  paidBy        String?             @map("paid_by") @db.Uuid
  paidAt        DateTime?           @map("paid_at") @db.Timestamptz
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  expense     Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  room        Room    @relation(fields: [roomId], references: [id], onDelete: Restrict)
  beneficiary User    @relation("UserReimbursements", fields: [beneficiaryId], references: [id], onDelete: Restrict)
  payer       User?   @relation("AdminPaidReimbursements", fields: [paidBy], references: [id], onDelete: SetNull)

  @@index([roomId, status])
  @@index([beneficiaryId])
  @@map("reimbursements")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roomId    String?  @map("room_id") @db.Uuid
  title     String   @db.VarChar(255)
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room? @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId     String?  @map("room_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String   @map("entity_id") @db.Uuid
  action     String   @db.VarChar(100)
  metadata   Json     @default("{}") @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  room  Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  actor User  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([roomId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
